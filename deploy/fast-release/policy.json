    "(^|/)docker-compose(?:\\..*)?\\.ya?ml$",
    "(^|/)requirements(?:\\..*)?$",
    "(^|/)(?:pyproject\\.toml|uv\\.lock|Pipfile(?:\\.lock)?|poetry\\.lock)$",
    "^frontend/(?:package(?:-lock)?\\.json|pnpm-lock\\.yaml|yarn\\.lock|vite\\.config\\..*)$",
