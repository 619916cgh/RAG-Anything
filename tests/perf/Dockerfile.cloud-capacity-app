ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# This is intentionally a narrow, test-only layer over an already available
# app image. It cannot alter the production image or enable the override
# unless the isolated Compose profile sets both performance-only variables.
RUN python -c 'from pathlib import Path; p = Path("/app/server.py"); source = p.read_text(); old = "limiter = Limiter(key_func=get_remote_address, default_limits=[\"120/minute\"])"; new = "_default_rate_limit = \"120/minute\"\nif (\n    os.getenv(\"RAGANYTHING_ENV\") == \"performance\"\n    and os.getenv(\"PERF_ISOLATED_RATE_LIMIT\") == \"10000/minute\"\n):\n    _default_rate_limit = \"10000/minute\"\nlimiter = Limiter(key_func=get_remote_address, default_limits=[_default_rate_limit])"; assert old in source, "expected rate limiter declaration is unavailable"; p.write_text(source.replace(old, new))'

# Router-specific limits would otherwise throttle every generated identity by
# the shared loopback client address.  This layer is used only for the
# capacity-mode isolated image; the production image and its protections stay
# unchanged.
RUN python -c 'from pathlib import Path; paths = (Path("/app/raganything/routers/auth.py"), Path("/app/raganything/routers/knowledge.py")); limits = ("5/minute", "10/minute", "20/minute", "30/minute"); [p.write_text(__import__("functools").reduce(lambda text, limit: text.replace(limit, "10000/minute"), limits, p.read_text())) for p in paths]'

# Current uploads use a 32-hex task ID in their staged filename.  Keep this
# test-only candidate layer aligned with the source repair while testing the
# currently deployed base image, which still has the legacy 8-hex checks.
RUN python -c 'from pathlib import Path; p = Path("/app/raganything/services/kb_service.py"); source = p.read_text(); old = "== 9"; expected = 7; assert source.count(old) == expected, "expected staged upload checks are unavailable"; p.write_text(source.replace(old, "in {9, 33}"))'

# The deployed base image predates the query-core publish/lease ordering fix.
# Mirror the source change only in this disposable layer so the isolated run
# exercises the candidate without altering a production image.
RUN python -c 'from pathlib import Path; p = Path("/app/raganything/services/kb_service.py"); s = p.read_text(); sig = "        key: KBInstanceKey | None = None,\n    ) -> None:\n        \"\"\"Store a KB instance and evict LRU entries if over capacity."; assert s.count(sig) == 1, "expected query-core cache signature is unavailable"; s = s.replace(sig, "        key: KBInstanceKey | None = None,\n        acquire_query_lease: bool = False,\n    ) -> None:\n        \"\"\"Store a KB instance and evict LRU entries if over capacity.", 1); start = s.index("        previous = self._store.get(name)"); end = s.index("\n\n    async def evict", start); body = s[start:end]; body = "\n".join(("    " + line) if line else line for line in body.splitlines()); body = body.replace("    await self._evict_if_needed()", "    if acquire_query_lease:\n        self.acquire_query_lease(name, instance)\n    await self._evict_if_needed_locked()", 1); s = s[:start] + "        async with self._eviction_lock:\n" + body + s[end:]; old = "        async with self._eviction_lock:\n            while len(self._store) > self._max_size:"; assert s.count(old) == 1, "expected eviction lock block is unavailable"; s = s.replace(old, "        async with self._eviction_lock:\n            await self._evict_if_needed_locked()\n\n    async def _evict_if_needed_locked(self) -> None:\n        while len(self._store) > self._max_size:", 1); s = s.replace("    async with _kb_locks[name]:\n        if acquire_query_lease", "    async with _kb_locks[name]:\n        query_lease_acquired = False\n        if acquire_query_lease", 1); call = "                ),\n            )\n            kb_logger.info(f\"[KB] 初始化知识库实例: {name} workspace={target}\")"; assert s.count(call) == 1, "expected query-core publish call is unavailable"; s = s.replace(call, "                ),\n                acquire_query_lease=acquire_query_lease,\n            )\n            query_lease_acquired = acquire_query_lease\n            kb_logger.info(f\"[KB] 初始化知识库实例: {name} workspace={target}\")", 1); s = s.replace("        if acquire_query_lease:\n            # The cache entry is chosen and leased while the per-KB lock is", "        if acquire_query_lease and not query_lease_acquired:\n            # The cache entry is chosen and leased while the per-KB lock is", 1); p.write_text(s)'

# The capacity-only image adds a random-key-gated internal control endpoint.
# It exists only for the isolated performance image and profiles the single
# event loop between explicit start/stop requests over the loopback test path.
RUN python -c 'from pathlib import Path; p = Path("/app/server.py"); source = p.read_text(); anchor = "\n\nif __name__ == \"__main__\":\n"; injected = "\n\nif os.getenv(\"RAGANYTHING_ENV\") == \"performance\" and os.getenv(\"PERF_CPU_PROFILING\") == \"1\":\n    import cProfile\n    import hmac\n    from fastapi import Header, HTTPException\n\n    _perf_cpu_profile = cProfile.Profile()\n    _perf_cpu_profile_active = False\n\n    @app.post(\"/api/internal/perf/cpu-profile/{action}\", include_in_schema=False)\n    async def _perf_cpu_profile_control(action: str, x_raganything_perf_profile: str = Header(default=\"\")):\n        global _perf_cpu_profile_active\n        expected = os.getenv(\"PERF_CPU_PROFILE_KEY\", \"\")\n        if not expected or not hmac.compare_digest(x_raganything_perf_profile, expected):\n            raise HTTPException(404)\n        if action == \"start\":\n            _perf_cpu_profile.enable()\n            _perf_cpu_profile_active = True\n            return {\"status\": \"started\"}\n        if action == \"stop\":\n            _perf_cpu_profile.disable()\n            _perf_cpu_profile_active = False\n            _perf_cpu_profile.dump_stats(\"/tmp/raganything-perf-cpu.pstats\")\n            return {\"status\": \"stopped\"}\n        raise HTTPException(404)\n"; assert source.count(anchor) == 1, "expected server entrypoint anchor is unavailable"; p.write_text(source.replace(anchor, injected + anchor))'

# Fixed diagnostic codes are available only in this test image, when phase
# attribution is explicitly enabled. No exception or request value is used.
RUN python -c 'from pathlib import Path; q = chr(39); p = Path("/app/raganything/routers/agent.py"); source = p.read_text(); init = "        citation_context = \"\""; acquire = "            timing.start(\"query_core_acquire\")"; setup = "            query_kb_lease = acquire_task.result()"; assert source.count(init) == 1 and source.count(acquire) == 1 and source.count(setup) == 1, "expected SSE attribution anchors are unavailable"; helper = "        _perf_sse_error_stage = " + q + "unknown" + q + "\n        def _perf_sse_error_payload(message):\n            payload = {" + q + "type" + q + ": " + q + "error" + q + ", " + q + "content" + q + ": message}\n            if os.getenv(" + q + "RAGANYTHING_ENV" + q + ") == " + q + "performance" + q + " and os.getenv(" + q + "PERF_SSE_PHASE_ATTRIBUTION" + q + ") == " + q + "1" + q + ":\n                payload[" + q + "code" + q + "] = _perf_sse_error_stage\n            return payload"; source = source.replace(init, init + "\n" + helper).replace(acquire, "            _perf_sse_error_stage = " + q + "query_core_acquire" + q + "\n" + acquire).replace(setup, setup + "\n            _perf_sse_error_stage = " + q + "pre_agent_info_setup" + q); old = "yield f\"data: {json.dumps({" + q + "type" + q + ": " + q + "error" + q + ", " + q + "content" + q + ": str(exc)}, ensure_ascii=False)}\\n\\n\""; new = "yield f\"data: {json.dumps(_perf_sse_error_payload(str(exc)), ensure_ascii=False)}\\n\\n\""; assert source.count(old) == 2, "expected generic SSE error exits are unavailable"; p.write_text(source.replace(old, new))'
