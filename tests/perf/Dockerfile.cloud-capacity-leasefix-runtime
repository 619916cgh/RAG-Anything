ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Clean disposable candidate: capacity-only throttling, query-core lease fix,
# and the bounded profile control route. No source mounts or production use.
RUN python -c 'from pathlib import Path; p=Path("/app/server.py"); s=p.read_text(); old="limiter = Limiter(key_func=get_remote_address, default_limits=[\"120/minute\"])"; new="_default_rate_limit = \"120/minute\"\nif os.getenv(\"RAGANYTHING_ENV\") == \"performance\" and os.getenv(\"PERF_ISOLATED_RATE_LIMIT\") == \"10000/minute\":\n    _default_rate_limit = \"10000/minute\"\nlimiter = Limiter(key_func=get_remote_address, default_limits=[_default_rate_limit])"; assert old in s; p.write_text(s.replace(old,new,1))'
RUN python -c 'from pathlib import Path; paths=(Path("/app/raganything/routers/auth.py"),Path("/app/raganything/routers/knowledge.py")); limits=("5/minute","10/minute","20/minute","30/minute"); [p.write_text(__import__("functools").reduce(lambda t,l:t.replace(l,"10000/minute"),limits,p.read_text())) for p in paths]'
RUN python -c 'from pathlib import Path; p=Path("/app/raganything/services/kb_service.py"); s=p.read_text(); sig="        key: KBInstanceKey | None = None,\n    ) -> None:\n        \"\"\"Store a KB instance and evict LRU entries if over capacity."; assert s.count(sig)==1; s=s.replace(sig,"        key: KBInstanceKey | None = None,\n        acquire_query_lease: bool = False,\n    ) -> None:\n        \"\"\"Store a KB instance and evict LRU entries if over capacity.",1); anchor="        self._total_loads += 1\n        await self._evict_if_needed()"; assert s.count(anchor)==1; s=s.replace(anchor,"        self._total_loads += 1\n        if acquire_query_lease:\n            self.acquire_query_lease(name, instance)\n        await self._evict_if_needed()",1); s=s.replace("    async with _kb_locks[name]:\n        if acquire_query_lease","    async with _kb_locks[name]:\n        query_lease_acquired = False\n        if acquire_query_lease",1); call="                ),\n            )\n            kb_logger.info(f\"[KB] 初始化知识库实例: {name} workspace={target}\")"; assert s.count(call)==1; s=s.replace(call,"                ),\n                acquire_query_lease=acquire_query_lease,\n            )\n            query_lease_acquired = acquire_query_lease\n            kb_logger.info(f\"[KB] 初始化知识库实例: {name} workspace={target}\")",1); s=s.replace("        if acquire_query_lease:\n            # The cache entry is chosen and leased while the per-KB lock is","        if acquire_query_lease and not query_lease_acquired:\n            # The cache entry is chosen and leased while the per-KB lock is",1); p.write_text(s)'
RUN python -c 'from pathlib import Path; p=Path("/app/server.py"); s=p.read_text(); anchor="\n\nif __name__ == \"__main__\":\n"; injected="\n\nif os.getenv(\"RAGANYTHING_ENV\") == \"performance\" and os.getenv(\"PERF_CPU_PROFILING\") == \"1\":\n    import cProfile, hmac\n    from fastapi import Header, HTTPException\n    _perf_cpu_profile = cProfile.Profile()\n    @app.post(\"/api/internal/perf/cpu-profile/{action}\", include_in_schema=False)\n    async def _perf_cpu_profile_control(action: str, x_raganything_perf_profile: str = Header(default=\"\")):\n        expected = os.getenv(\"PERF_CPU_PROFILE_KEY\", \"\")\n        if not expected or not hmac.compare_digest(x_raganything_perf_profile, expected):\n            raise HTTPException(404)\n        if action == \"start\":\n            _perf_cpu_profile.enable(); return {\"status\": \"started\"}\n        if action == \"stop\":\n            _perf_cpu_profile.disable(); _perf_cpu_profile.dump_stats(\"/tmp/raganything-perf-cpu.pstats\"); return {\"status\": \"stopped\"}\n        raise HTTPException(404)\n"; assert s.count(anchor)==1; p.write_text(s.replace(anchor,injected+anchor,1))'
